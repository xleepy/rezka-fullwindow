{
  "manifest_version": 3,
  "name": "Rezka Window Player",
  "version": "1.0.0",
  "description": "Expand the Rezka video player to fill the browser window.",
  "permissions": ["activeTab", "scripting"],
  "action": { "default_title": "Fill window / Restore player" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["*://*.rezka.ag/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Fill window / Restore player"
    }
  }
}
